{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEN measured run",
  "type": "object",
  "required": [
    "model",
    "quant",
    "gpu",
    "context",
    "users",
    "engine",
    "tok_s"
  ],
  "properties": {
    "model": {
      "type": "string"
    },
    "quant": {
      "type": "string",
      "description": "a quantization name from the calculator, e.g. fp16 / bf16, Q4_0, GPTQ / AWQ int4"
    },
    "gpu": {
      "type": "string"
    },
    "context": {
      "type": "integer",
      "minimum": 1,
      "description": "tokens per user"
    },
    "users": {
      "type": "integer",
      "minimum": 1,
      "description": "concurrent sessions tested"
    },
    "engine": {
      "type": "string",
      "description": "e.g. vllm 0.6.3, llama.cpp b3900"
    },
    "tok_s": {
      "type": "number",
      "description": "decode tokens/s per user"
    },
    "vram_gib": {
      "type": "number",
      "description": "peak VRAM used across all GPUs, in GiB. Only a run with this field can establish \"measured to fit\"; a speed-only run says nothing about memory"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "URL where the number was published"
    },
    "gpu_count": {
      "type": "integer",
      "minimum": 1,
      "description": "number of GPUs used (default 1)"
    },
    "kv_dtype": {
      "type": "string",
      "enum": [
        "fp16",
        "bf16",
        "fp8",
        "int8"
      ],
      "description": "KV cache type used (default fp16)"
    }
  },
  "additionalProperties": false
}
